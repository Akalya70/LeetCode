class Solution {
    public List<Integer> minSubsequence(int[] nums) {
        List<Integer> list = new ArrayList<>();
        Arrays.sort(nums);
        int sum = 0;
        int curSum = 0;

        for (int i : nums) {
            sum += i;
        }

        for (int i = nums.length - 1; i >= 0; i--) {
            if (sum < curSum) {
                break;
            }

            sum -= nums[i];
            curSum += nums[i];
            list.add(nums[i]);
        }

        return list;
    }
}
