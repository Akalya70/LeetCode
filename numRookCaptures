class Solution {
    public int numRookCaptures(char[][] board) {
        int rookRow = 0;
        int rookCol = 0;

        // 1. Find the rook's position
        for (int r = 0; r < 8; r++) {
            for (int c = 0; c < 8; c++) {
                if (board[r][c] == 'R') {
                    rookRow = r;
                    rookCol = c;
                    break;
                }
            }
        }

        int captures = 0;
        int[][] directions = {
            {-1, 0}, // up
            {1, 0},  // down
            {0, -1}, // left
            {0, 1}   // right
        };

        // 2. Scan in all 4 directions
        for (int[] dir : directions) {
            int r = rookRow + dir[0];
            int c = rookCol + dir[1];

            while (r >= 0 && r < 8 && c >= 0 && c < 8) {
                char piece = board[r][c];
                if (piece == 'B') {
                    break; // Blocked by bishop
                }
                if (piece == 'p') {
                    captures++; // Can capture this pawn, then stop
                    break;
                }
                r += dir[0];
                c += dir[1];
            }
        }

        return captures;
    }
}
